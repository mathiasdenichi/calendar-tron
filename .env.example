# Copy to .env on the kiosk machine. Vite inlines these at BUILD time, so a
# missing value bakes `undefined` into the bundle and the app white-screens
# (createClient throws "supabaseUrl is required" on import).
#
# .env is gitignored and `git reset --hard` leaves untracked files alone, so
# this file survives deploys. Do not commit the real one.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional overrides. Both fall back to the defaults hardcoded in the
# Supabase edge functions when unset.
# VITE_ICLOUD_CALENDAR_URL=https://p152-caldav.icloud.com/published/2/...
# VITE_ICLOUD_PHOTOS_TOKEN=...
